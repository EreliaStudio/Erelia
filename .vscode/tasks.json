{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Prepare Sparkle Debug",
      "type": "process",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/dev/prepare-sparkle.ps1", "-Configuration", "Debug"],
      "problemMatcher": []
    },
    {
      "label": "Prepare Sparkle Release",
      "type": "process",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/dev/prepare-sparkle.ps1", "-Configuration", "Release"],
      "problemMatcher": []
    },
    {
      "label": "Configure Debug",
      "type": "process",
      "command": "cmake",
      "args": ["--preset", "debug"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Prepare Sparkle Debug",
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Configure Release",
      "type": "process",
      "command": "cmake",
      "args": ["--preset", "release"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Prepare Sparkle Release",
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Build Debug Client",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "debug", "--target", "EreliaClient"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Configure Debug",
      "dependsOrder": "sequence",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Build Release Client",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "release", "--target", "EreliaClient"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Configure Release",
      "dependsOrder": "sequence",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Build Debug Server",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "debug", "--target", "EreliaServer"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Configure Debug",
      "dependsOrder": "sequence",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Build Release Server",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "release", "--target", "EreliaServer"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Configure Release",
      "dependsOrder": "sequence",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Build Debug Core Tests",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "debug", "--target", "EreliaCoreTestSuite"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Configure Debug",
      "dependsOrder": "sequence",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Build Release Core Tests",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "release", "--target", "EreliaCoreTestSuite"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Configure Release",
      "dependsOrder": "sequence",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Build Debug Server Tests",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "debug", "--target", "EreliaServerTestSuite"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Configure Debug",
      "dependsOrder": "sequence",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Build Release Server Tests",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "release", "--target", "EreliaServerTestSuite"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Configure Release",
      "dependsOrder": "sequence",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Build Debug Client Tests",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "debug", "--target", "EreliaClientTestSuite"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Configure Debug",
      "dependsOrder": "sequence",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Build Release Client Tests",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "release", "--target", "EreliaClientTestSuite"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Configure Release",
      "dependsOrder": "sequence",
      "problemMatcher": "$gcc"
    }
  ]
}
