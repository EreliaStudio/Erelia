{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Client (Debug)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/client/EreliaClient.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "environment": [{ "name": "PATH", "value": "${workspaceFolder}/build/debug/vcpkg_installed/x64-windows/debug/bin;${env:PATH}" }],
      "preLaunchTask": "Build Debug Client"
    },
    {
      "name": "Client (Release)",
      "type": "cppvsdbg",
      "request": "launch",
