{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_MANIFEST_MODE": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Client and server (Debug)",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "${sourceDir}/build/dependencies/sparkle-full-Debug-install",
        "VCPKG_MANIFEST_FEATURES": "client"
      }
    },
    {
      "name": "release",
      "displayName": "Client and server (Release)",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "${sourceDir}/build/dependencies/sparkle-full-Release-install",
        "VCPKG_MANIFEST_FEATURES": "client"
      }
    },
    {
      "name": "headless-debug",
      "displayName": "Core and server (Debug)",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "${sourceDir}/build/dependencies/sparkle-core-Debug-install",
        "ERELIA_BUILD_CLIENT": "OFF"
      }
    },
    {
      "name": "headless-release",
      "displayName": "Core and server (Release)",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "${sourceDir}/build/dependencies/sparkle-core-Release-install",
        "ERELIA_BUILD_CLIENT": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "headless-debug", "configurePreset": "headless-debug" },
    { "name": "headless-release", "configurePreset": "headless-release" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "headless-debug", "configurePreset": "headless-debug", "output": { "outputOnFailure": true } },
    { "name": "headless-release", "configurePreset": "headless-release", "output": { "outputOnFailure": true } }
  ]
}
